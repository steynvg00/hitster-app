# Supabase — public values, safe to expose in the browser
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — secret, server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase — JWT secret for server-side session verification.
# Find in: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Cookie signing — generate with: openssl rand -hex 32
# Still needed for hitster_team and hitster_player cookies.
COOKIE_SECRET=your-32-byte-hex-secret-here

# Admin panel password — kept for reference, no longer used for auth (replaced by Supabase Auth)
HOST_PASSWORD=your-strong-host-password-here

# Comma-separated list of emails bootstrapped as super_admins in host_whitelist
SUPER_ADMIN_EMAILS=
